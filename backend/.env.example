PORT=5000
MONGO_URI=mongodb://localhost:27017/music_game
JWT_SECRET=your_super_secret_jwt_key_change_this
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ── Music Provider ────────────────────────────────────────────────────────────
# Choose one: spotify | deezer | youtube
# 'deezer' is the default — free, no subscription, 30s preview MP3s
MUSIC_PROVIDER=deezer

# ── Spotify (requires Spotify Premium for full playback) ──────────────────────
# Client Credentials flow — only metadata + preview_url (may be null)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── YouTube (free tier: 10,000 units/day) ─────────────────────────────────────
# Playback via iframe embed — no subscription needed
# Get a key at https://console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=

# ── Deezer ────────────────────────────────────────────────────────────────────
# No API key required for basic search & 30s previews
